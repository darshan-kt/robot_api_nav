# =============================================================================
# Makefile.aws — distributed deployment
#
# Splits the single-host `make build`/`make run` (Makefile) into two halves
# that run on two different machines:
#
#   AWS side   (appstore + mqtt-broker + hive_api) — an EC2 instance
#   Robot side (robotstore only)                   — whatever's playing "the
#                                                     robot" today: your
#                                                     laptop + turtlebot_sim,
#                                                     or real hardware later
#
# See README's "☁️ Deploying to AWS" section for the full picture — this
# file is the automation for it, not a replacement for reading that first.
#
# Usage:
#   AWS side — run ON the EC2 instance:
#     cp .env.aws.example .env.aws   # fill in real values first
#     make -f Makefile.aws aws_build
#     make -f Makefile.aws aws_run
#
#   Robot side — run on your laptop (with turtlebot_sim) today, or on the
#   real robot later. turtlebot_sim itself is unrelated to this file — keep
#   starting it exactly as documented in turtlebot_mcp_ros2 (make run_sim /
#   run_sim_headless from that directory); robotstore and the sim talk to
#   each other over local ROS 2 DDS same as always, only robotstore's MQTT
#   leg now reaches out to AWS instead of a local broker:
#     cp .env.robot.example .env.robot   # fill in the AWS broker's address
#     make -f Makefile.aws build_robot
#     make -f Makefile.aws run_robot
# =============================================================================

include Makefile

AWS_ENV_FILE   ?= .env.aws
ROBOT_ENV_FILE ?= .env.robot

.PHONY: aws-help aws_build aws_run aws_stop aws_logs aws_check \
        build_robot run_robot stop_robot logs_robot \
        check-aws-env check-robot-env

.DEFAULT_GOAL := aws-help

aws-help:
	@echo "Makefile.aws — distributed deployment (AWS side + robot side)"
	@echo ""
	@echo "  ── AWS side (run ON the EC2 instance) ───────────────────────────────"
	@echo "  make -f Makefile.aws aws_build   Build hive_api + appstore images"
	@echo "  make -f Makefile.aws aws_run     Start appstore + mqtt-broker + hive_api"
	@echo "  make -f Makefile.aws aws_stop    Stop those three services"
	@echo "  make -f Makefile.aws aws_logs    Tail their logs"
	@echo "  make -f Makefile.aws aws_check   curl the public gateway's /health"
	@echo ""
	@echo "  ── Robot side (run on your laptop+turtlebot_sim today, real robot later) ─"
	@echo "  make -f Makefile.aws build_robot  colcon-build robotstore (same as"
	@echo "                                     'make build_robotstore' in the main"
	@echo "                                     Makefile — this just also checks"
	@echo "                                     .env.robot exists first)"
	@echo "  make -f Makefile.aws run_robot    Start ONLY robotstore, pointed at the"
	@echo "                                     AWS broker (--no-deps: does NOT spin"
	@echo "                                     up a local mqtt-broker)"
	@echo "  make -f Makefile.aws stop_robot   Stop it"
	@echo "  make -f Makefile.aws logs_robot   Tail its logs"
	@echo ""
	@echo "  Both sides need their own env file first — see .env.aws.example and"
	@echo "  .env.robot.example. Neither .env.aws nor .env.robot is committed."

# =============================================================================
# AWS side — appstore + mqtt-broker + hive_api. NOT robotstore — that never
# runs here, see build_robot/run_robot below. All three ARE part of the
# single-host docker-compose.yml already; this just runs a subset of it with
# a different env file, same file everyone else uses.
# =============================================================================

check-aws-env:
	@test -f $(AWS_ENV_FILE) || { \
		echo "[aws] Missing $(AWS_ENV_FILE) — copy .env.aws.example to $(AWS_ENV_FILE)"; \
		echo "      and fill in real values (MQTT credentials, CORS origin, ROBOT_ID) first."; \
		exit 1; \
	}

aws_build: check-aws-env
	@echo "[aws_build] Building hive_api + appstore for the AWS side (no ROS 2, no robotstore) ..."
	docker compose --env-file $(AWS_ENV_FILE) build hive_api appstore
	@echo "[aws_build] Done. mqtt-broker needs no build step — it's a stock image."

aws_run: check-aws-env
	@echo "[aws_run] Starting appstore + mqtt-broker + hive_api (AWS side) ..."
	@echo "[aws_run] robotstore is deliberately NOT part of this — see run_robot below."
	ARCH_TAG=$(ARCH) docker compose --env-file $(AWS_ENV_FILE) up -d appstore mqtt-broker hive_api
	@echo "[aws_run] Up. 'make -f Makefile.aws aws_check' once it's had a few seconds to connect."

aws_stop:
	docker compose --env-file $(AWS_ENV_FILE) stop appstore mqtt-broker hive_api

aws_logs:
	docker compose --env-file $(AWS_ENV_FILE) logs -f appstore mqtt-broker hive_api

aws_check:
	@curl -sf http://localhost:1717/health && echo "" || \
		echo "[aws_check] hive_api not answering on :1717 yet — check 'aws_logs'."

# =============================================================================
# Robot side — robotstore ONLY, pointed at the AWS broker instead of a
# co-located one. Run this on whatever machine is playing "the robot" right
# now; same targets whether that's your laptop+turtlebot_sim or real
# hardware later, only .env.robot's ROBOT_MQTT_HOST changes.
#
# --no-deps on run_robot matters: robotstore's docker-compose.yml entry
# still lists `depends_on: [mqtt-broker]` (needed for the single-host case),
# and without --no-deps `docker compose up robotstore` would happily spin up
# an UNWANTED local broker here too — the opposite of what this split is for.
# =============================================================================

check-robot-env:
	@test -f $(ROBOT_ENV_FILE) || { \
		echo "[robot] Missing $(ROBOT_ENV_FILE) — copy .env.robot.example to $(ROBOT_ENV_FILE)"; \
		echo "        and fill in the AWS broker's address + credentials first."; \
		exit 1; \
	}

build_robot: check-robot-env build_robotstore
	@echo "[build_robot] robotstore workspace built — same as 'make build_robotstore'."

run_robot: check-robot-env
	@echo "[run_robot] Starting robotstore ONLY, pointed at the AWS broker (not a local one) ..."
	@mkdir -p $(HIVE_STORE_DIR)/build $(HIVE_STORE_DIR)/install $(HIVE_STORE_DIR)/log
	@chmod +x $(HIVE_STORE_DIR)/docker/dev/entrypoint_robotstore.sh
	ARCH_TAG=$(ARCH) docker compose --env-file $(ROBOT_ENV_FILE) up -d --no-deps robotstore
	@echo "[run_robot] Up. 'make -f Makefile.aws logs_robot' to confirm it reached the AWS broker —"
	@echo "            look for '[mqtt] connected to <host>:<port>' same as any other run."

stop_robot:
	docker compose --env-file $(ROBOT_ENV_FILE) stop robotstore

logs_robot:
	docker logs -f robotstore_cont-run-arm
