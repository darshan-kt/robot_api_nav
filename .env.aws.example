# Copy this file to .env.aws and fill in real values. .env.aws is
# gitignored — never commit real credentials or domains here.
#
# Used by: make -f Makefile.aws aws_build / aws_run
# Read by: docker-compose.yml (appstore, mqtt-broker, hive_api services)

# ── Broker auth ──────────────────────────────────────────────────────────
# Only takes effect once the broker actually enforces auth — swapping
# mqtt-broker's image for eclipse-mosquitto with a password_file, or adding
# the HiveMQ file-RBAC extension to the existing HiveMQ CE image. Setting
# these two lines alone does NOT secure the broker by itself; see README's
# "☁️ Deploying to AWS" → "Broker authentication" section before deploying
# for real. Leave blank for an initial anonymous end-to-end test only.
MQTT_USERNAME=
MQTT_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated. Defaults to "*" (any origin) if unset — fine for a
# quick first test, wrong once this is reachable from the public internet.
CORS_ALLOWED_ORIGINS=https://appstore.yourdomain.com

# ── Robot identity ───────────────────────────────────────────────────────
# Must match ROBOT_ID in .env.robot on the robot side EXACTLY — this is
# the MQTT topic namespace (hive/<ROBOT_ID>/...) the two sides rendezvous
# on. A mismatch here doesn't error, it just silently means nothing ever
# connects to anything — no traffic on either side's expected topics.
ROBOT_ID=robot-1
