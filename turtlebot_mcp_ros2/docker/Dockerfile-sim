# ============================================================================
# TurtleBot3 Gazebo Simulation + Nav2 — self-contained image
#
# Everything comes from apt (no colcon build needed):
#   - Gazebo 11 + gazebo_ros
#   - turtlebot3_gazebo   (world + robot model)
#   - turtlebot3_navigation2 + nav2 stack (incl. default turtlebot3 map)
#   - CycloneDDS RMW — matches hive_api / robotstore containers
#
# Build:  make build_sim          (or docker build -f docker/Dockerfile-sim ...)
# Run:    make run_sim            (X11 GUI: gzclient + RViz on your desktop)
#
# ARCH NOTE: amd64-only, on purpose. Gazebo Classic (gazebo11) and its ROS
# bindings (ros-humble-gazebo-ros-pkgs, ros-humble-turtlebot3-gazebo) were
# never published for arm64 on the ROS build farm — confirmed by querying
# the arm64 apt index directly, apt-get simply has no candidate for either
# package on that architecture. This is an upstream gap, not something a
# base-image swap can fix; the successor project (Gazebo Sim / gz-sim) does
# support arm64, but TurtleBot3's official simulation packages are built
# against Gazebo Classic, so using it here would mean replacing worlds,
# spawn tooling, and launch files, not just this Dockerfile.
#
# In practice this is also how TurtleBot3 is normally run: Gazebo simulation
# on a desktop-class amd64 workstation, while the Raspberry Pi 5 runs the
# real onboard stack only (see backend/docker/dev/Dockerfile-api and
# Dockerfile-arm, both arm64-verified) and joins the same ROS_DOMAIN_ID over
# the network. Do not change this FROM line to a multi-arch base — it will
# build "successfully" on arm64 host arch metadata but fail on the apt
# install step below the moment gazebo packages are requested.
# ============================================================================
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-turtlebot3 \
        ros-humble-turtlebot3-gazebo \
        ros-humble-turtlebot3-navigation2 \
        ros-humble-navigation2 \
        ros-humble-nav2-bringup \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-gazebo-ros-pkgs \
    && rm -rf /var/lib/apt/lists/*

# ── Defaults (all overridable via docker-compose environment) ────────────────
# burger_cam: burger footprint + an RGB-D camera (/depth_cam/image_raw) for
# the Remote Controller's WebRTC feed. ros-humble-gazebo-ros-pkgs above
# already provides libgazebo_ros_camera.so — no extra apt packages needed.
ENV TURTLEBOT3_MODEL=burger_cam \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    ROS_DOMAIN_ID=0

WORKDIR /home/sim_ws

COPY docker/entrypoint_sim.sh /home/sim_ws/entrypoint_sim.sh
RUN chmod +x /home/sim_ws/entrypoint_sim.sh

ENTRYPOINT ["/home/sim_ws/entrypoint_sim.sh"]
