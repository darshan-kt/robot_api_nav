# ============================================================================
# RPLIDAR ROS 2 driver — colcon-built from vendored source (../rplidar_ros2)
#
# Multi-arch (linux/amd64 + linux/arm64): ros:humble-ros-base is the official
# multi-arch ROS Humble image, and rplidar_ros itself is a plain ament_cmake
# package (rclcpp/sensor_msgs/std_srvs/rclcpp_components + a bundled,
# architecture-portable serial SDK) — no GPU/Gazebo dependency, so unlike
# Dockerfile-sim this builds and runs identically on both architectures.
# Verified with `colcon build` under linux/amd64 and QEMU-emulated
# linux/arm64.
#
# Build:  docker buildx build --platform linux/arm64 -f docker/Dockerfile-rplidar -t rplidar_ros2:arm64 --load ..
#         (or: make build_rplidar)
# Run:    make run_rplidar   (needs the LIDAR's USB serial device passed through)
# ============================================================================
FROM ros:humble-ros-base

SHELL ["/bin/bash", "-lc"]

ENV DEBIAN_FRONTEND=noninteractive \
    WORKSPACE=/home/rplidar_ws

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-humble-rclcpp \
        ros-humble-rclcpp-components \
        ros-humble-sensor-msgs \
        ros-humble-std-srvs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR ${WORKSPACE}
COPY rplidar_ros2/ ${WORKSPACE}/src/rplidar_ros/

RUN source /opt/ros/humble/setup.bash \
    && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY docker/entrypoint_rplidar.sh ${WORKSPACE}/entrypoint_rplidar.sh
RUN chmod +x ${WORKSPACE}/entrypoint_rplidar.sh

ENTRYPOINT ["/home/rplidar_ws/entrypoint_rplidar.sh"]
