# ============================================================================
# ROS 2 Humble (Ubuntu 22.04) — multi-arch image (linux/amd64 + linux/arm64)
#
# NOTE: this file previously had two `FROM` lines (an arm64v8/ros:humble one
# followed by an osrf/ros:humble-desktop one). Docker only honors the LAST
# FROM in a single-stage build, so every "arm" build was silently compiling
# the amd64-only osrf image. Using the official multi-arch `ros:humble`
# image fixes that: buildx resolves the correct manifest for whatever
# --platform is requested (linux/arm64 for Raspberry Pi 5, linux/amd64 here).
# ============================================================================
FROM ros:humble

# ---- Build Arguments ----
ARG USERNAME=charlie
ARG UID=1001
ARG GID=1001

# ---- Environment Setup ----
ENV TZ=Europe/Copenhagen \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

# ---- System Timezone & Locale ----
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    apt-get update && \
    apt-get install -y locales && \
    locale-gen en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*

# ============================================================================
# User Creation
# ============================================================================
RUN if getent passwd ${UID}; then userdel -f -r $(getent passwd ${UID} | cut -d: -f1); fi && \
    if getent group ${GID}; then groupdel $(getent group ${GID} | cut -d: -f1); fi && \
    groupadd -g ${GID} ${USERNAME} && \
    useradd -m -s /bin/zsh -u ${UID} -g ${GID} ${USERNAME} && \
    usermod -aG sudo ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-${USERNAME}

# ============================================================================
# Dependencies (Base Tools, ROS 2 Packages)
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake ninja-build pkg-config \
    git curl wget zsh sudo \
    libssl-dev libcurl4-openssl-dev \
    libgl1-mesa-glx libgl1-mesa-dev \
    python3-pip python3-dev python3-numpy python3-colcon-common-extensions \
    python3-vcstool python3-rosdep \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-rviz2 \
    ros-humble-tf-transformations \
    ros-humble-behaviortree-cpp-v3 \
    ros-humble-behaviortree-cpp \
    ros-humble-nav2-msgs \
    ros-humble-nav2-bringup \
    ros-humble-twist-mux \
    ros-humble-cv-bridge \
    # hive_camera_bridge (WebRTC): cv-bridge converts sensor_msgs/Image to
    # OpenCV frames; the libav*/opus/vpx/srtp2 dev headers are PyAV/aiortc's
    # native build fallback in case a prebuilt aarch64 wheel isn't available
    # for the exact Python version on this base image — pip prefers the
    # wheel when one exists, these just stop that from being a hard failure.
    ffmpeg libavdevice-dev libavfilter-dev libopus-dev libvpx-dev libsrtp2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir Pillow paho-mqtt aiortc aiohttp

# ============================================================================
# Oh My Zsh Setup
# ============================================================================
USER ${USERNAME}
ENV ZSH=/home/${USERNAME}/.oh-my-zsh

RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended && \
    git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH}/custom/plugins/zsh-autosuggestions && \
    git clone https://github.com/zsh-users/zsh-syntax-highlighting ${ZSH}/custom/plugins/zsh-syntax-highlighting && \
    echo 'export ZSH=$HOME/.oh-my-zsh' >> /home/${USERNAME}/.zshrc && \
    echo 'ZSH_THEME="ys"' >> /home/${USERNAME}/.zshrc && \
    echo 'plugins=(git zsh-autosuggestions zsh-syntax-highlighting)' >> /home/${USERNAME}/.zshrc && \
    echo 'source $ZSH/oh-my-zsh.sh' >> /home/${USERNAME}/.zshrc && \
    echo 'source /opt/ros/humble/setup.zsh' >> /home/${USERNAME}/.zshrc

USER root

# ============================================================================
# CycloneDDS Source Build (v0.10.2)
# ============================================================================
ARG CYCLONEDDS_VERSION=0.10.2
ENV CYCLONEDDS_HOME=/opt/cyclonedds

RUN git clone --branch ${CYCLONEDDS_VERSION} --depth 1 https://github.com/eclipse-cyclonedds/cyclonedds.git /tmp/cyclonedds && \
    mkdir -p /tmp/cyclonedds/build && cd /tmp/cyclonedds/build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=${CYCLONEDDS_HOME} && \
    make -j$(nproc) && make install && rm -rf /tmp/cyclonedds

# ============================================================================
# Environment & Workspace setup
# ============================================================================
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    QT_X11_NO_MITSHM=1 \
    WORKSPACE=/home/${USERNAME}
ENV ROS_WS=${WORKSPACE}/ros2_ws
ENV ROS_WS_SRC=${ROS_WS}/src

RUN mkdir -p ${ROS_WS_SRC} && chown -R ${USERNAME}:${USERNAME} ${WORKSPACE}

RUN rosdep init || true && rosdep update

# ============================================================================
# behaviortree_cpp (v4) library path fixup — REQUIRED for bt_runner to build
# ============================================================================
# ros-humble-behaviortree-cpp 4.x installs its library into the multiarch
# directory (lib/x86_64-linux-gnu/ or lib/aarch64-linux-gnu/), but the ament
# export script it ships with searches ONLY lib/:
#
#   find_library(_lib NAMES "behaviortree_cpp"
#                PATHS "${behaviortree_cpp_DIR}/../../../lib"
#                NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
#
# NO_DEFAULT_PATH means CMAKE_LIBRARY_PATH/LD_LIBRARY_PATH can't rescue it, so
# find_package(behaviortree_cpp REQUIRED) dies with "exports the library
# 'behaviortree_cpp' which couldn't be found" and bt_runner never configures.
# Linking it back where ament looks is the only fix that works. Globbing the
# triplet keeps this correct on both amd64 and arm64, and the pattern matches
# only libbehaviortree_cpp.so* — NOT the separately-installed v3 library.
#
# Deliberately placed LAST, not next to the apt install that creates the
# problem: every layer above this one clones from GitHub (oh-my-zsh, its two
# zsh plugins, the CycloneDDS source build) and those are anonymous clones
# that GitHub rejects with a 401 on git-upload-pack whenever the build host's
# IP is being rate-limited. Inserting a layer above them invalidates their
# cache and turns a working build into a failing one that has nothing to do
# with this fixup. Keep cheap local fixups at the bottom.
# ============================================================================
RUN find /opt/ros/humble/lib -maxdepth 2 -name 'libbehaviortree_cpp.so*' \
        -not -path '/opt/ros/humble/lib/libbehaviortree_cpp.so*' \
        -exec ln -sf {} /opt/ros/humble/lib/ \; \
    && test -e /opt/ros/humble/lib/libbehaviortree_cpp.so

# ============================================================================
# Final Setup
# ============================================================================
USER ${USERNAME}
WORKDIR ${WORKSPACE}

COPY --chown=${USERNAME}:${USERNAME} ./docker/dev/entrypoint_robotstore.sh ${WORKSPACE}/entrypoint_robotstore.sh
RUN chmod +x ${WORKSPACE}/entrypoint_robotstore.sh

# The XML file will be mounted via docker-compose
ENV CYCLONEDDS_URI=file://${WORKSPACE}/cyclonedds.xml

ENTRYPOINT ["/home/charlie/entrypoint_robotstore.sh"]
CMD ["/bin/zsh"]