<root BTCPP_format="4">
  <BehaviorTree ID="GoToB">
    <Sequence name="Root">
      <!-- Hard-coded goal -->
      <SendNav2Goal name="send_nav2_goal_B"
                    x="-3.46" y="-11.7" yaw_deg="0.0" frame_id="map"
                    goal_id="{nav_goal_id_B}"/>
      <!-- Watch Nav2 status for that UUID -->
      <MonitorNav2Status name="wait_nav2_done_B"
                         goal_id="{nav_goal_id_B}"
                         timeout_ms="600000"
                         status_topic="/navigate_to_pose/_action/status"/>
    </Sequence>
  </BehaviorTree>
</root>
