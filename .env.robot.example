# Copy this file to .env.robot and fill in real values. .env.robot is
# gitignored — never commit real credentials or domains here.
#
# Run this on whatever machine is playing "the robot" right now — your
# laptop alongside turtlebot_sim, or real hardware later. Same file either
# way; only ROBOT_MQTT_HOST changes when you eventually point this at a
# real robot's network instead of your dev laptop's.
#
# Used by: make -f Makefile.aws build_robot / run_robot
# Read by: docker-compose.yml (robotstore service only)

# ── Where the AWS broker actually is ────────────────────────────────────
# The EC2 instance's public DNS name (preferred — set up Route53 or even
# just use the instance's public DNS before this changes on every reboot)
# or public IP. No sensible default — this MUST be filled in.
ROBOT_MQTT_HOST=13.51.74.241

# 1883 = plain (matches this repo's dev-mode broker out of the box, fine
# for a first end-to-end test over the internet). Switch to 8883 once the
# broker has a TLS listener configured (see README's AWS section) — sending
# MQTT credentials in the clear across the public internet on 1883 past an
# initial test is exactly the kind of thing worth not doing twice.
ROBOT_MQTT_PORT=1883

# Must be IDENTICAL to MQTT_USERNAME/MQTT_PASSWORD in .env.aws on the AWS
# side — same broker, same credentials, two machines.
MQTT_USERNAME=
MQTT_PASSWORD=

# Must match ROBOT_ID in .env.aws EXACTLY — see that file's comment on why.
ROBOT_ID=robot-1
