# hive_api_gateway is a plain Python service now (2026 MQTT refactor) — it
# never runs colcon, so these can no longer be generated, but keep them
# ignored in case an old branch/muscle-memory command recreates them.
build_api/
install_api/
log_api/

# colcon build output for the backend ROS2 workspace — regenerated by
# `colcon build`; was previously tracked and caused conflicts on every rebase.
backend/build/
backend/install/
backend/log/

# Python bytecode caches
__pycache__/
*.pyc

# Real env files for the AWS/robot split (Makefile.aws) — hold real broker
# credentials and domains. Templates (.env.aws.example, .env.robot.example)
# stay tracked; the filled-in copies never do.
.env.aws
.env.robot

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test venv (see docs/TESTING.md) and coverage output
.venv-test/
coverage/
.pytest_cache/
